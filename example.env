# Local Packet Whisperer Environment Configuration
# Copy this file to .env and adjust the values as needed

# =============================================================================
# OpenAI API Configuration
# =============================================================================
# API key for OpenAI or OpenAI-compatible endpoints
# For local LLM servers that don't require auth, use a placeholder token
# Required if using OpenAI, Azure OpenAI, or other paid API services
# Example: token-abc123, sk-proj-xxx, or any placeholder for local servers
OPENAI_API_KEY=not-needed

# =============================================================================
# LLM Server Configuration
# =============================================================================
# Hostname or IP address of your LLM server
# Use a specific IP if connecting to a remote LLM server
# Example: 100.64.0.1 for remote server
LLM_SERVER=

# Port number for the LLM server
# Default Ollama port is 11434
# For custom endpoints, use the appropriate port (e.g., 1234)
LLM_SERVER_PORT=11434

# =============================================================================
# PCAP Files Configuration
# =============================================================================
# Local directory containing PCAP files to analyze
# This directory will be mounted as read-only into the container at /pcaps
# Change this to the path where your PCAP files are stored
PCAP_DIR=./pcaps
